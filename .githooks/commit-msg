#!/usr/bin/env node
// 커밋 메시지가 .gitmessage 템플릿 형식을 지키는지 검사한다.
// 등록: git config core.hooksPath .githooks
const fs = require('fs');

const TYPES = ['feat', 'fix', 'test', 'refactor', 'docs', 'chore', 'build'];
const SCOPES = [
  'plan', 'order', 'payment', 'issue', 'install', 'admin',
  'mock', 'front', 'infra', 'harness', 'arch', 'learn', 'ci',
];
const SECTIONS = ['[왜]', '[무엇]', '[검증]', '[관련]'];

const raw = fs.readFileSync(process.argv[2], 'utf8');
const lines = raw
  .split(/\r?\n/)
  .filter((l) => !l.startsWith('#'));

// 앞쪽 빈 줄 제거
while (lines.length && lines[0].trim() === '') lines.shift();

const subject = lines[0] || '';
const errors = [];

// git이 자동으로 만드는 메시지는 통과
if (/^(Merge|Revert) /.test(subject)) process.exit(0);

const m = subject.match(/^(\w+)\(([\w-]+)\): (.+)$/);
if (!m) {
  errors.push('제목 형식이 "<type>(<scope>): <요약>" 이 아닙니다.');
} else {
  const [, type, scope, summary] = m;
  if (!TYPES.includes(type)) errors.push(`허용되지 않은 type: ${type} (허용: ${TYPES.join(', ')})`);
  if (!SCOPES.includes(scope)) errors.push(`허용되지 않은 scope: ${scope} (허용: ${SCOPES.join(', ')})`);
  if ([...summary].length > 50) errors.push(`요약이 50자를 넘습니다 (${[...summary].length}자).`);
}

if (lines.length > 1 && lines[1].trim() !== '') {
  errors.push('제목 다음 줄은 비어 있어야 합니다.');
}

const body = lines.slice(2).join('\n');
for (const s of SECTIONS) {
  if (!body.includes(s)) errors.push(`본문에 ${s} 섹션이 없습니다.`);
}

if (errors.length) {
  console.error('\n[commit-msg] 커밋 메시지가 템플릿(.gitmessage)과 다릅니다:');
  for (const e of errors) console.error('  - ' + e);
  console.error('\n템플릿 확인: cat .gitmessage\n');
  process.exit(1);
}
