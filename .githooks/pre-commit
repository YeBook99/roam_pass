#!/usr/bin/env node
// 보호 브랜치(main, develop)에 직접 커밋하는 것을 막고, 작업 브랜치 이름 규칙을 검사한다.
// 브랜치 전략: <type>/<scope>-<설명> 브랜치에서 작업 → develop으로 PR → (릴리스) develop → main PR
const { execSync } = require('child_process');
const path = require('path');
const { PROTECTED, TYPES, PATTERN } = require(path.join(__dirname, '..', 'scripts', 'lib', 'branch-rules.cjs'));

const branch = execSync('git rev-parse --abbrev-ref HEAD', { encoding: 'utf8' }).trim();

if (process.env.ALLOW_PROTECTED_COMMIT === '1') process.exit(0);

if (PROTECTED.includes(branch)) {
  console.error(`\n[pre-commit] '${branch}' 브랜치에는 직접 커밋할 수 없습니다.`);
  console.error('  작업 브랜치를 만든 뒤 develop으로 PR을 올리세요.');
  console.error('  예) git switch -c feature/payment-webhook-idempotency develop\n');
  process.exit(1);
}

if (branch !== 'HEAD' && !PATTERN.test(branch)) {
  console.error(`\n[pre-commit] 브랜치 이름 '${branch}'이(가) 규칙과 다릅니다.`);
  console.error('  규칙: <type>/<scope>-<짧은-설명>  (소문자, 숫자, 하이픈)');
  console.error(`  type: ${TYPES.join(' | ')}`);
  console.error('  예) feature/admin-anomaly-list, fix/payment-amount-check\n');
  process.exit(1);
}
