spring:
  application:
    name: {{appName}}
  datasource:
    url: ${DB_URL}
    username: ${DB_USERNAME}
    password: ${DB_PASSWORD}
  jpa:
    open-in-view: false            # ARCHITECTURE.md §9-11
    hibernate:
      ddl-auto: validate           # 스키마는 Flyway가 만든다 (§9-10)
    properties:
      hibernate:
        jdbc:
          time_zone: UTC           # 저장은 UTC (§14-4)
  flyway:
    enabled: true
