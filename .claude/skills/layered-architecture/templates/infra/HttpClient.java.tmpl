package {{base}}.infra.{{system}};

import {{base}}.global.error.BusinessException;
import {{base}}.global.error.CommonErrorCode;
import lombok.RequiredArgsConstructor;
import org.springframework.web.client.ResourceAccessException;
import org.springframework.web.client.RestClient;
import org.springframework.web.client.RestClientResponseException;

// 외부 HTTP 호출은 여기서만 한다. 외부 형식 ↔ 우리 결과 변환, 외부 예외 → 우리 예외 변환 (§13)
// 재시도하지 않는다. 재시도 여부와 상한은 Service·스케줄러가 정한다 (§13-6)
@RequiredArgsConstructor
public class Http{{System}}Client implements {{System}}Client {

    private final RestClient restClient;

    @Override
    public {{System}}Result send(Long requestId) {
        try {
            {{System}}SendResponse response = restClient.post()
                    .uri("/send")
                    .body(new {{System}}SendRequest(requestId))
                    .retrieve()
                    .body({{System}}SendResponse.class);
            return new {{System}}Result(response.id());
        } catch (ResourceAccessException e) {
            // 연결 실패·타임아웃
            throw new BusinessException(CommonErrorCode.EXTERNAL_UNAVAILABLE);
        } catch (RestClientResponseException e) {
            throw new BusinessException(CommonErrorCode.EXTERNAL_ERROR, "{{system}} status=" + e.getStatusCode().value());
        }
    }

    // 외부 요청·응답 형식. 우리 API DTO를 재사용하지 않는다 (§13-4)
    record {{System}}SendRequest(Long requestId) {
    }

    record {{System}}SendResponse(String id) {
    }
}
