package {{base}}.{{feature}}.controller;

import {{base}}.{{feature}}.dto.{{Feature}}CreateRequest;
import {{base}}.{{feature}}.dto.{{Feature}}Response;
import {{base}}.{{feature}}.service.{{Feature}}Service;
import jakarta.validation.Valid;
import java.net.URI;
import lombok.RequiredArgsConstructor;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

// 요청 → DTO, 형식 검증, Service 메서드 하나 호출, DTO 반환 (ARCHITECTURE.md §5)
@RestController
@RequiredArgsConstructor
@RequestMapping("/api/{{features}}")
public class {{Feature}}Controller {

    private final {{Feature}}Service {{feature}}Service;

    @PostMapping
    public ResponseEntity<{{Feature}}Response> create(@Valid @RequestBody {{Feature}}CreateRequest request) {
        {{Feature}}Response response = {{feature}}Service.create(request.toCommand());
        return ResponseEntity.created(URI.create("/api/{{features}}/" + response.id())).body(response);
    }

    @GetMapping("/{id}")
    public {{Feature}}Response get(@PathVariable Long id) {
        return {{feature}}Service.get(id);
    }
}
