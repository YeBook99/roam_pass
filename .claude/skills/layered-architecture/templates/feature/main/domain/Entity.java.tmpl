package {{base}}.{{feature}}.domain;

import {{base}}.global.entity.BaseTimeEntity;
import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import lombok.AccessLevel;
import lombok.Getter;
import lombok.NoArgsConstructor;

// protected 기본 생성자, setter 없음, 정적 팩토리, 의도가 드러나는 변경 메서드 (ARCHITECTURE.md §9)
// 다른 기능의 Entity는 객체가 아니라 ID로 참조한다 (§4-8)
@Entity
@Getter
@NoArgsConstructor(access = AccessLevel.PROTECTED)
public class {{Entity}} extends BaseTimeEntity {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    @Column(nullable = false, unique = true, length = 30)
    private String code;

    @Column(nullable = false, length = 100)
    private String name;

    public static {{Entity}} create(String code, String name) {
        {{Entity}} entity = new {{Entity}}();
        entity.code = code;
        entity.name = name;
        return entity;
    }

    public void rename(String newName) {
        this.name = newName;
    }
}
