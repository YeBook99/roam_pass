package {{base}}.{{feature}}.exception;

import {{base}}.global.error.ErrorCode;
import lombok.RequiredArgsConstructor;
import org.springframework.http.HttpStatus;

// 이 기능의 에러 코드. code()는 enum 이름 그대로 응답의 code 필드가 된다 (ARCHITECTURE.md §10)
@RequiredArgsConstructor
public enum {{Feature}}ErrorCode implements ErrorCode {

    {{FEATURE}}_NOT_FOUND(HttpStatus.NOT_FOUND, "{{featureLabel}}을(를) 찾을 수 없습니다."),
    DUPLICATE_CODE(HttpStatus.CONFLICT, "이미 사용 중인 코드입니다.");

    private final HttpStatus status;
    private final String message;

    @Override
    public HttpStatus status() {
        return status;
    }

    @Override
    public String code() {
        return name();
    }

    @Override
    public String message() {
        return message;
    }
}
