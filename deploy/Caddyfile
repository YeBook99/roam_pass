# SITE_DOMAIN 예: 3-35-12-34.sslip.io (EC2 퍼블릭 IP의 점을 하이픈으로). 도메인을 사지 않아도 인증서를 받을 수 있다
{$SITE_DOMAIN} {
	# 백엔드 API와 모의 PG·공급사. 웹훅·콜백도 이 길로 들어온다 (서명 검증 때문에 본문을 그대로 넘긴다)
	handle /api/* {
		reverse_proxy backend:8080
	}
	handle /mock/* {
		reverse_proxy backend:8080
	}
	# 나머지는 화면
	handle {
		reverse_proxy frontend:3000
	}
}
