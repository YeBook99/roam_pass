# 운영 서버(EC2)의 ~/roampass/.env 에 둘 값의 목록입니다. (이름이 .env.* 이면 gitignore에 걸려서 이 이름을 씁니다) 이 파일은 자리표시자만 둡니다.
# 서버에서: cp deploy/prod.env.example .env && chmod 600 .env 후 값을 채웁니다. 시크릿은 openssl rand -hex 32 로 만듭니다.
SITE_DOMAIN=<EC2-퍼블릭-IP를-하이픈으로>.sslip.io
APP_PUBLIC_BASE_URL=https://<EC2-퍼블릭-IP를-하이픈으로>.sslip.io
POSTGRES_PASSWORD=<openssl-rand-hex-32>
PG_WEBHOOK_SECRET=<openssl-rand-hex-32>
SUPPLIER_CALLBACK_SECRET=<openssl-rand-hex-32>
